# MySQL
MYSQL_ROOT_PASSWORD=your_mysql_root_password

# Database
DB_USERNAME=root
DB_PASSWORD=your_mysql_root_password

# Redis
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=

# JWT (at least 32 bytes)
JWT_SECRET=your_jwt_secret_at_least_32_bytes_long_here

# 数据加密 (Base64 encoded key)
ENCRYPTION_SECRET_KEY=your_base64_encoded_encryption_key_here

# Spring
SPRING_PROFILES_ACTIVE=dev

# 邮件 (可选)
MAIL_HOST=smtp.163.com
MAIL_PORT=465
MAIL_USERNAME=your_email@163.com
MAIL_PASSWORD=your_email_password
MAIL_FROM=your_email@163.com
