# MySQL
MYSQL_ROOT_PASSWORD=your_mysql_root_password

# Database
DB_USERNAME=root
DB_PASSWORD=your_mysql_root_password
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/idle_items_school?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here

# JWT (至少 32 字节)
JWT_SECRET=your_jwt_secret_at_least_32_bytes_long_here

# 数据加密 (Base64 encoded key, 至少 16 字节)
ENCRYPTION_SECRET_KEY=your_base64_encoded_encryption_key_here

# Spring Profile
SPRING_PROFILES_ACTIVE=prod
