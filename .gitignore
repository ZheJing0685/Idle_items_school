# ============================================
# 闲置物品校园交易平台 .gitignore
# ============================================

# ==================== Java / Spring Boot ====================
*.class
*.jar
*.war
*.ear
*.pyc
__pycache__/

# ==================== Build Tools ====================
# Maven
.mvn/
mvnw
mvnw.cmd
target/

# Gradle
.gradle/
build/
dist/
nbbuild/
nbdist/
.nb-gradle/

# ==================== Frontend ====================
frontend/node_modules/
frontend/dist/
frontend/.next/
frontend/out/
node_modules/

# ==================== Logs ====================
*.log
logs/
!logs/.gitkeep
!**/logs/.gitkeep
backend/logs/

# ==================== IDE & Editor ====================
# IntelliJ IDEA
.idea/
*.iws
*.iml
*.ipr

# VSCode
.vscode/

# Eclipse
.classpath
.project
.settings/

# NetBeans
nbproject/private/

# ==================== OS Files ====================
# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db

# ==================== Environment Variables ====================
.env
.env.local
.env.*.local
!.env.example

# Backend environment configs
backend/.env
backend/.env.local
backend/.env.*.local
!backend/.env.example
backend/src/main/resources/application-local.yml

# Frontend environment configs
frontend/.env
frontend/.env.local
frontend/.env.*.local
frontend/.env.development
frontend/.env.production
frontend/.env.staging
!frontend/.env.example

# ==================== Docker ====================
docker-compose.override.yml

# ==================== Temporary Files ====================
*.tmp
*.temp
*.swp
*.swo
*~

# ==================== Backup Files ====================
*.bak
*.backup
*.old

# ==================== Sensitive Files ====================
*.p12
*.key
*.pem
*.jks

# ==================== Database Files ====================
*.db
*.sqlite3
dump.rdb

# ==================== Compressed Files ====================
*.zip
*.tar.gz
*.rar

# ==================== User Uploads (Runtime Data) ====================
backend/uploads/
uploads/

# ==================== Test Reports & Coverage ====================
frontend/test-results/
frontend/tests/reports/
coverage/

# ==================== Runtime Outputs ====================
outputs/

# ==================== Project Specific ====================
*.sql~
console.txt
log.txt
backup*.sql

# Image editor temp files
*.png~
*.jpg~
*.jpeg~
*.gif~


docs/
scripts/
.githooks/
GIT_WORKFLOW.md
# Spec/plan/report files (not source code)
.specs/
.playwright-mcp/
.trae_spec/
doc/
CONTEXT.md
findings.md
progress.md
task_plan.md
task_plan_backup.md
vulnerabilities_report_*.md
websocket-*-report.md
修复报告.md


# Database exports (may contain sensitive data)
sql/idle_items_school.sql
skills-lock.json
nul

# AI agent & MCP tooling
.od/
*.zip
