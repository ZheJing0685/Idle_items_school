# ============================================
# 闲置物品校园交易平台 .gitignore
# ============================================

# ==================== Java / Spring Boot ====================
*.class
*.jar
*.war
*.ear
*.pyc
__pycache__/

# ==================== Build Tools ====================
# Maven
.mvn/
mvnw
mvnw.cmd
target/

# Gradle
.gradle/
build/
dist/
nbbuild/
nbdist/
.nb-gradle/

# ==================== Frontend ====================
frontend/node_modules/
frontend/dist/
frontend/.next/
frontend/out/
node_modules/

# ==================== Logs ====================
*.log
logs/
!logs/.gitkeep
!**/logs/.gitkeep
backend/logs/

# ==================== IDE & Editor ====================
# IntelliJ IDEA
.idea/
*.iws
*.iml
*.ipr

# VSCode
.vscode/

# Eclipse
.classpath
.project
.settings/

# NetBeans
nbproject/private/

# ==================== OS Files ====================
# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db

# ==================== Environment Variables ====================
.env
.env.local
.env.*.local
!.env.example

# Frontend environment configs
frontend/.env.development
frontend/.env.production
frontend/.env.staging

# ==================== Docker ====================
docker-compose.override.yml

# ==================== Temporary Files ====================
*.tmp
*.temp
*.swp
*.swo
*~

# ==================== Backup Files ====================
*.bak
*.backup
*.old

# ==================== Sensitive Files ====================
*.p12
*.key
*.pem
*.jks

# ==================== Database Files ====================
*.db
*.sqlite3

# ==================== Compressed Files ====================
*.zip
*.tar.gz
*.rar

# ==================== AI Agent Tools ====================
.agents/
Vibe-Skills/

# ==================== Trae IDE ====================
.trae/

# ==================== User Uploads (Runtime Data) ====================
backend/uploads/
uploads/

# ==================== Test Reports & Coverage ====================
frontend/test-results/
frontend/tests/reports/
coverage/

# ==================== Runtime Outputs ====================
outputs/

# ==================== Project Specific ====================
*.sql~
console.txt
log.txt
backup*.sql

# Image editor temp files
*.png~
*.jpg~
*.jpeg~
*.gif~

# Temporary notes
分析.txt
已修复清单.txt

# Temporary planning docs
docs/

scripts/ 
# Database exports (may contain sensitive data)
sql/idle_items_school.sql
